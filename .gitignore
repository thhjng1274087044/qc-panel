.env.local
.env
*.key
*.pem

# ── 数据：样本入库，运行时产物不入库 ────────────────────────────────────
data/qc.db
data/qc.db-journal
data/*.db
data/*.db-journal
data/records.json.bak
data/thumb/

# 证据图由 build_data.py 从源目录重建，36MB 不入库
img/

# ── 日志与临时 ─────────────────────────────────────────────────────────
*.log
*.bak
*.tmp
__pycache__/
*.py[cod]
.venv/
venv/

